# Server-only. Never prefix with NEXT_PUBLIC_. Leave empty to serve only the bundled sample page.
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# Contact form (Resend). If RESEND_API_KEY or CONTACT_FROM_EMAIL is empty, the form falls back to a prefilled mailto: link.
RESEND_API_KEY=
CONTACT_FROM_EMAIL=
CONTACT_TO_EMAIL=cole@colebonawitz.com
# Optional: shows a "Pick a time" link on /audit and /contact. Leave empty to use the form alone.
NEXT_PUBLIC_BOOKING_URL=
